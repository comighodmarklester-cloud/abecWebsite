<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 620 MB: five registration credentials and one ID at 100 MB each, plus multipart overhead. -->
        <requestLimits maxAllowedContentLength="650117120" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
