<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 520 MB: five registration files at 100 MB each, plus multipart overhead. -->
        <requestLimits maxAllowedContentLength="545259520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
