<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ABEC_System</RootNamespace>
    <!-- App Password lives in user-secrets / env / smtp.local.json — never in source. -->
    <UserSecretsId>abec-system-8f3c2a1e-4b9d-4e7a-9c21-email-smtp</UserSecretsId>
    <!-- Runtime data and nested build output must not become project/publish inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/App_Data/**;**/bin/**;**/obj/**;**/publish/**;**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supply production configuration through the host, not developer config files. -->
    <Content Update="appsettings.json;appsettings.*.json;smtp.local.json" CopyToPublishDirectory="Never" />
    <!-- Program.cs serves these HTML files from the physical Views directory. -->
    <Content Include="Views/**/*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts/BatchVerification/**/*.cs" />
    <Compile Remove="scripts/PasswordHash/**/*.cs" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <!-- Pin patched transitive dependencies until their parent packages raise the minimums. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

</Project>
